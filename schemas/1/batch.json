{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dhh1128/overture-protocol/main/schemas/1/batch.json",
  "title": "Overture batch",
  "description": "The a block of an /overture/batch exn (spec \u00a75.1).",
  "type": "object",
  "required": [
    "version",
    "overtures"
  ],
  "properties": {
    "version": {
      "$ref": "#/$defs/version"
    },
    "overtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://raw.githubusercontent.com/dhh1128/overture-protocol/main/schemas/1/overture.json"
      }
    },
    "waitUntil": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "$defs": {
    "said": {
      "type": "string",
      "description": "A SAID: a qb64 Blake3, Blake2, SHA2 or SHA3 digest of 256 or 512 bits. A verifier still parses it with a CESR parser, which a pattern cannot fully do.",
      "pattern": "^(?:[EFGHI][A-P][A-Za-z0-9_-]{42}|0[DEFG][A-D][A-Za-z0-9_-]{85})$"
    },
    "aid": {
      "type": "string",
      "description": "A qb64 AID prefix: a basic Ed25519, ECDSA or Ed448 key, or a self-addressing digest.",
      "pattern": "^(?:[BDEFGHI][A-P][A-Za-z0-9_-]{42}|0[DEFG][A-D][A-Za-z0-9_-]{85}|1AA[ABIJ][A-Za-z0-9_-]{44}|1AA[CD][A-Za-z0-9_-]{76}|1AAE[A-Za-z0-9_-]{152})$"
    },
    "dateTime": {
      "type": "string",
      "description": "A time in KERI's dt form: ISO 8601 with microseconds and a UTC offset.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}[+-][0-9]{2}:[0-9]{2}$"
    },
    "version": {
      "type": "string",
      "description": "The Overture version, major.minor, here with major 1 (spec \u00a79).",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)$"
    },
    "saids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/said"
      }
    }
  }
}
